# Neon PostgreSQL Connection URL
DATABASE_URL=

# Auth.js Session Secret
AUTH_SECRET=

# Application-Level AES-256-GCM Encryption Key (falls back to AUTH_SECRET if unset)
ENCRYPTION_KEY=

# Google AI Provider API Key
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional Gemini Model Override (defaults to gemini-3.5-flash-lite)
GEMINI_MODEL=

# Base Application URL (Optional / Production)
NEXT_PUBLIC_APP_URL=
